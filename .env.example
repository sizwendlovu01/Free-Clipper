# ClipForge AI settings. Copy to .env for local use; on Railway set them as service Variables.
# Every value is optional unless marked REQUIRED for production. Older FC_* names still work.

# ---- Security ----
SECRET_KEY=                    # REQUIRED in production: long random string (signs session cookies)
SESSION_HTTPS_ONLY=false       # true behind HTTPS (Railway): cookies only sent over HTTPS
SETUP_TOKEN=                   # code required to create the first (admin) account on a fresh server
ALLOW_SIGNUP=false             # true lets visitors create their own accounts (public beta)
CLIENT_IP_HEADER=              # header with the real client IP behind a proxy; Railway: X-Real-IP

# ---- Storage (STORAGE_ROOT defaults to the Railway volume mount path when one is attached) ----
STORAGE_ROOT=                  # e.g. /data; local default ./data
DATABASE_PATH=                 # default $STORAGE_ROOT/freeclipper.db
PROJECTS_DIR=                  # default $STORAGE_ROOT/jobs (uploads, downloads, clips per project)
MODEL_DIR=                     # default $STORAGE_ROOT/models (Whisper models, downloaded once)
TEMP_DIR=                      # default system temp; short-lived scratch files, cleaned automatically

# ---- Capacity (beta defaults; raise as your server allows) ----
MAX_CONCURRENT_JOBS=1          # videos processed at the same time
MAX_WORKERS=1                  # clips rendered in parallel within one video (ffmpeg processes)
FFMPEG_THREADS=0               # threads per ffmpeg process (0 = automatic)
MAX_UPLOAD_SIZE_MB=500
MAX_DOWNLOAD_SIZE_MB=2048      # largest video downloaded from a link
MAX_VIDEO_DURATION=1800        # seconds
MAX_CLIPS_PER_JOB=10
JOB_TIMEOUT_SECONDS=5400       # a job running longer is stopped and marked failed
MAX_JOB_ATTEMPTS=2             # retries after a crash (e.g. out of memory) before giving up
MAX_QUEUED_JOBS=20             # server-wide waiting queue
MIN_FREE_DISK_MB=1024          # refuse new videos when free storage drops below this

# ---- Per-user quotas (admins are exempt) ----
USER_MAX_ACTIVE_JOBS=2
USER_JOBS_PER_DAY=10
USER_RENDERS_PER_HOUR=30
USER_MAX_STORAGE_MB=2048
SIGNUPS_PER_IP_PER_DAY=5

# ---- Cleanup ----
CLEANUP_INTERVAL_MINUTES=60
TEMP_FILE_MAX_AGE_HOURS=6
SOURCE_RETENTION_DAYS=0        # delete source videos after N days (clips are kept); 0 = keep

# ---- Transcription (local faster-whisper) ----
WHISPER_MODEL=small            # tiny | base | small | medium | large-v3 | turbo | distil-large-v3
WHISPER_ALLOWED_MODELS=        # comma list users may pick, e.g. tiny,base,small (empty = all)
WHISPER_CPU_THREADS=0          # 0 = library default
WHISPER_BATCH_SIZE=0           # 0 = auto; lower it if transcription runs out of memory
PRELOAD_WHISPER=true           # download the default model at startup

# ---- Highlight finder: auto = Claude if a key is set, else Ollama if reachable, else built-in ----
AI_PROVIDER=auto               # auto | claude | ollama | heuristic
ANTHROPIC_API_KEY=
CLAUDE_MODEL=claude-opus-5-5
CLAUDE_EFFORT=medium           # low | medium | high
OLLAMA_URL=                    # e.g. http://localhost:11434; empty disables Ollama
OLLAMA_MODEL=qwen2.5:3b
OLLAMA_NUM_CTX=32768

# ---- Local development only ----
FC_HOST=127.0.0.1              # 0.0.0.0 to reach it from other devices (the Docker image sets this)
FC_PORT=8000                   # PORT (set by Railway) takes priority
FC_X264_PRESET=veryfast
FC_X264_CRF=20
