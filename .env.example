# Copy to .env and adjust. Every setting is optional.

# Network
FC_HOST=127.0.0.1          # use 0.0.0.0 to reach it from other devices / inside Docker
FC_PORT=8000
FC_HTTPS_ONLY_COOKIES=false # set true when served behind HTTPS
FC_ALLOW_SIGNUP=false       # let anyone create an account from the login page
FC_SETUP_TOKEN=             # set on public servers: code required to create the first (admin) account

# Capacity: videos processed at the same time (the rest wait in the queue)
FC_MAX_CONCURRENT_JOBS=1
FC_MAX_UPLOAD_MB=8192

# Transcription (local faster-whisper). Models: tiny base small medium large-v3 turbo distil-large-v3
FC_WHISPER_MODEL=small
FC_WHISPER_DEVICE=auto      # auto | cpu | cuda
FC_WHISPER_COMPUTE_TYPE=auto
FC_WHISPER_CPU_THREADS=0    # 0 = library default
FC_WHISPER_BATCH_SIZE=0     # 0 = auto (8 on CPU, 16 on GPU); lower it if you run out of memory

# Highlight finder: auto (Claude if a key is set, else Ollama if running, else heuristic) | claude | ollama | heuristic
FC_AI_PROVIDER=auto
ANTHROPIC_API_KEY=
FC_CLAUDE_MODEL=claude-opus-5-5
FC_CLAUDE_EFFORT=medium     # low | medium | high
FC_OLLAMA_URL=http://localhost:11434
FC_OLLAMA_MODEL=qwen2.5:3b
FC_OLLAMA_NUM_CTX=32768

# Encoding
FC_X264_PRESET=veryfast
FC_X264_CRF=20
FC_RENDER_WORKERS=3         # clips rendered at the same time per project

# Storage (defaults to ./data)
# FC_DATA_DIR=/data
